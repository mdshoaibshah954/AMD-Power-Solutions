@{
    ViewData["Title"] = "Solar Panel Solutions";
}

<section class="solar-page">

    <!-- Page Heading -->
    <div class="solar-heading">
        <h1>Our <span>Solar</span> Panel Brands</h1>
        <p>High-quality solar panels from trusted and leading brands.</p>
    </div>


    <!-- Adani Solar -->
    <div class="solar-brand-row">

        <div class="solar-brand-image">
            <img src="~/images/adani.png" alt="Adani Solar" />
        </div>

        <div class="solar-brand-content">
            <h2>Adani Solar</h2>

            <p>
                Adani Solar offers high-efficiency solar panels designed for
                reliable performance and long-term durability. A trusted choice
                for residential, commercial and industrial solar installations.
            </p>
        </div>

    </div>


    <!-- Luminous Solar -->
    <div class="solar-brand-row">

        <div class="solar-brand-image">
            <img src="~/images/luminous.png" alt="Luminous Solar" />
        </div>

        <div class="solar-brand-content">
            <h2>Luminous Solar</h2>

            <p>
                Luminous Solar provides reliable and efficient solar solutions
                for homes and businesses. Its solar products are designed for
                dependable performance and long-term energy savings.
            </p>
        </div>

    </div>


    <!-- Waaree Solar -->
    <div class="solar-brand-row">

        <div class="solar-brand-image">
            <img src="~/images/waaree.png" alt="Waaree Solar" />
        </div>

        <div class="solar-brand-content">
            <h2>Waaree Solar</h2>

            <p>
                Waaree Solar is known for high-quality and high-efficiency
                solar panels. It is a reliable choice for customers looking
                for long-term solar energy solutions.
            </p>
        </div>

    </div>


    <!-- Government Solar Subsidy -->
    <section class="solar-subsidy-banner">

        <img src="~/images/subsidy.png" alt="Government Solar Subsidy" />

    </section>

</section>