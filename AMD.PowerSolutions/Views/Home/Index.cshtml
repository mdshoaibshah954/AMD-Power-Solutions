                        </svg>

                    </div>


                    <div class="hero-feature-text">

                        <strong>24/7</strong>

                        <small>Support</small>

                    </div>

                </div>


            </div>

        </div>

    </div>

</section>



<!-- =========================================================
     SERVICES SECTION
     ========================================================= -->

<section id="services" class="services-section">

    <div class="container">


        <div class="section-heading text-center">

            <p class="section-subtitle">
                OUR SERVICES
            </p>

            <h2>
                Complete Power &amp; Security Solutions
            </h2>

            <p>
                Reliable products and professional services for homes,
                businesses and complete power protection.
            </p>

        </div>



        <div class="row g-3">


            <!-- SOLAR PANEL -->

            <div class="col-12 col-sm-6 col-lg">

                <div class="service-card">

                    <div class="service-image">

                        <img src="~/images/solar.png"
                             alt="Solar Panel" />

                    </div>


                    <div class="service-card-content">


                        <h3>
                            Solar Panel
                        </h3>

                        <p>
                            Harness the power of the sun and save on
                            your electricity bills.
                        </p>

                        <a href="/Home/Solar" class="service-btn">
                            <span>View More</span>
                            <span>→</span>
                        </a>

                    </div>

                </div>

            </div>



            <!-- INVERTER -->

            <div class="col-12 col-sm-6 col-lg">

                <div class="service-card">

                    <div class="service-image">

                        <img src="~/images/inv and batt.png"
                             alt="Inverter and battery Power System" />

                    </div>


                    <div class="service-card-content">

                       

                        <h3>Inverter &amp; Battery</h3>

                        <p>
                            Reliable power backup for your home and
                            business.
                        </p>

                        <a href="/Home/InverterBattery" class="service-btn">

                            View More
                            <span>→</span>

                        </a>

                    </div>

                </div>

            </div>



            



            <!-- CCTV -->

            <div class="col-12 col-sm-6 col-lg">

                <div class="service-card">

                    <div class="service-image">

                        <img src="~/images/camera.png"
                             alt="CCTV Security Camera" />

                    </div>


                    <div class="service-card-content">

                      

                        <h3>
                            CCTV Camera
                        </h3>

                        <p>
                            Keep your home and business safe with
                            advanced surveillance solutions.
                        </p>

                        <a href="/Home/CCTV" class="service-btn">

                            View More
                            <span>→</span>

                        </a>

                    </div>

                </div>

            </div>



            <!-- INSTALLATION -->

            <div class="col-12 col-sm-6 col-lg">

                <div class="service-card">

                    <div class="service-image">

                        <img src="~/images/installation.png"
                             alt="Solar Installation Service" />

                    </div>


                    <div class="service-card-content">

                       

                        <h3>
                            Installation Service
                        </h3>

                        <p>
                            Professional and safe installation by
                            experienced technicians.
                        </p>

                        <a href="/Home/Installation" class="service-btn">

                            View More
                            <span>→</span>

                        </a>

                    </div>

                </div>

            </div>


        </div>

    </div>

</section>



