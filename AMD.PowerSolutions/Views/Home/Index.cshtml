                    </div>


                    <div class="hero-feature-text">

                        <strong>Reliable</strong>

                        <small>Products</small>

                    </div>

                </div>



                <!-- PROFESSIONAL INSTALLATION -->

                <div class="hero-feature">

                    <div class="feature-icon">

                        <svg viewBox="0 0 48 48" aria-hidden="true">

                            <path class="icon-fill"
